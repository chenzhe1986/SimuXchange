{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "SimuXchange",
    "version": "1.0.0",
    "identifier": "com.simuxchange.app",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:14200",
        "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/build-all.ps1",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "SimuXchange · 模拟撮合网关",
                "width": 1360,
                "height": 860,
                "minWidth": 1024,
                "minHeight": 700,
                "center": true,
                "decorations": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.ico"
        ],
        "resources": {
            "../target/x86_64-unknown-linux-musl/release/simx-server": "Linux/simx-server",
            "../scripts/start.sh": "Linux/start.sh",
            "../scripts/stop.sh": "Linux/stop.sh"
        }
    }
}
